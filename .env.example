DATABASE_URL="postgresql://archer:archer@localhost:5432/archer_odds?schema=public"

# Odds provider. Set ONE key: with ODDS_API_KEY alone the app reads The Odds API
# (game lines + NBA props, one props call per game). If PARLAY_API_KEY is also
# set, ParlayAPI wins unless ODDS_PROVIDER="toa" forces The Odds API.
# The free tier omits several books; a paid plan is needed for the full board.
ODDS_API_KEY=""
# PARLAY_API_KEY=""
# ODDS_PROVIDER=""

# Shared secret required in the Authorization header for /api/cron/* routes
CRON_SECRET=""

# Private-edge gate. Set this to any password to put the WHOLE site behind HTTP
# Basic Auth (only you can view it). Blank = public, as before. API/cron routes
# are exempt so the pollers + Discord poster keep working. See src/proxy.ts.
SITE_ACCESS_PASSWORD=""

# Discord auto-post (optional). Paste your PREMIUM channel's webhook URL to have
# ARCHR post the daily +EV card there via the post-discord cron. Blank = dormant
# (nothing posts). DISCORD_FREE_WEBHOOK_URL is optional — if set, a single "free
# lean" (selection only, no EV/book) is posted to that public channel as a funnel.
DISCORD_WEBHOOK_URL=""
DISCORD_FREE_WEBHOOK_URL=""
# Optional #results channel webhook. If set, the post-results cron grades
# yesterday's posted plays and posts a transparent recap (W-L-P + unit P/L +
# running all-time record). Requires the add_posted_play migration to be applied.
DISCORD_RESULTS_WEBHOOK_URL=""

# Database compute budget guard (optional). With these set, /api/status shows
# this month's Neon compute use, and optional jobs (weather, soccer, tennis,
# F1/MLB backfills) pause past 80% of the budget. Unset = everything runs.
# API key: Neon console → Account settings → API keys. Project ID: Project settings.
NEON_API_KEY=
NEON_PROJECT_ID=
COMPUTE_BUDGET_CU_HOURS=50
