# Every environment variable the app reads, grouped by what it's for.
# Placeholders only: never commit real values. Anything optional can stay blank
# (or commented out); the feature it powers stays dormant.

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres (docker compose up -d). In production, the pooled Neon URL.
DATABASE_URL="postgresql://archer:archer@localhost:5432/archer_odds?schema=public"
# Optional: a direct (non-pooled) URL for `prisma migrate deploy`. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Cron auth ───────────────────────────────────────────────────────────────
# Required. Bearer token for every /api/cron/* route (Vercel Cron sends it;
# GitHub Actions use the same value as the CRON_SECRET repo secret).
CRON_SECRET="replace-with-a-long-random-string"

# ── Odds: the main feeds ────────────────────────────────────────────────────
# Set at least one key. With ODDS_API_KEY alone the app reads The Odds API (TOA).
# If PARLAY_API_KEY is also set, ParlayAPI wins unless ODDS_PROVIDER="toa".
ODDS_API_KEY=""
# PARLAY_API_KEY=""
# ODDS_PROVIDER=""          # "parlay" | "toa"; forces the global provider
# Comma-separated TOA bookmaker keys (default: ten US books + Pinnacle; past ten bills as two regions).
# ODDS_BOOKMAKERS="draftkings,fanduel,betmgm,..."

# Per-sport provider override ("parlay" | "toa" | "oddsblaze"). Unset = the
# global provider above. See src/lib/odds/providers/registry.ts.
# MLB_ODDS_PROVIDER=""
# NBA_ODDS_PROVIDER=""
# NFL_ODDS_PROVIDER=""
# UFC_ODDS_PROVIDER=""
# SOCCER_ODDS_PROVIDER=""
# TENNIS_ODDS_PROVIDER=""
# Needed only for a sport pointed at "oddsblaze" above.
# ODDSBLAZE_API_KEY=""

# Player-prop odds polling (spends credits). Off unless exactly "true".
# PLAYER_PROPS_ODDS_ENABLED="false"

# ── Odds: the all-sports engine (every other league the feeds carry) ────────
# odds-api.io key: adds the sports TOA doesn't carry (table tennis, darts, esports, ...).
# ODDS_API_IO_KEY=""
# ODDS_API_IO_BOOKMAKERS="..."   # comma-separated; default list in src/lib/allSports/feeds/oddsApiIo.ts
# ALL_SPORTS_FEED=""            # "toa" | "oddsapiio" | "both"; default: every feed with a key
# Monthly budgets, in each feed's own unit (TOA credits / odds-api.io requests).
# ALL_SPORTS_TOA_BUDGET="1500000"
# ALL_SPORTS_IO_BUDGET="3000000"
# Below this many TOA credits left, other sports pause so NBA/NFL/props never run dry.
# ALL_SPORTS_RESERVE="20000"

# ── UFC ─────────────────────────────────────────────────────────────────────
# Cito API: cards, fighter profiles and records. (Fight history also comes free
# from the UFCStats mirror, no key.)
# CITO_API_KEY=""

# ── Site ────────────────────────────────────────────────────────────────────
# Any password puts the WHOLE site behind HTTP Basic Auth. Blank = public.
# API/cron routes are exempt so jobs and the Discord poster keep working. See src/proxy.ts.
SITE_ACCESS_PASSWORD=""
# Absolute base URL for metadata, robots and the sitemap. Default: Vercel's production domain, else localhost.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"
# Unlocks /support/inbox?token=... ; unset = the page 404s.
# SUPPORT_INBOX_TOKEN=""

# ── Discord ─────────────────────────────────────────────────────────────────
# Webhooks (post-discord / post-results jobs). Each blank one stays dormant.
DISCORD_WEBHOOK_URL=""            # premium channel: the daily +EV card
DISCORD_FREE_WEBHOOK_URL=""       # public channel: one free lean (funnel)
DISCORD_RESULTS_WEBHOOK_URL=""    # #results: graded recap of posted plays
# DISCORD_SLATE_WEBHOOK_URL=""    # the full slate (no units, never recorded)
# DISCORD_TIPS_WEBHOOK_URL=""     # the daily tip
# Slash commands: interactions endpoint verification (/api/discord/interactions; unset = 503 dormant).
# DISCORD_PUBLIC_KEY=""
# Scripts only (register commands, audit, purge):
# DISCORD_APP_ID=""
# DISCORD_BOT_TOKEN=""
# DISCORD_GUILD_ID=""

# ── Database compute budget guard (optional) ────────────────────────────────
# With these set, /api/status shows this month's Neon compute use, the tick
# thins to even hours past 60% of the budget, and optional jobs pause past 80%.
# Unset = everything runs. API key: Neon console → Account settings → API keys.
# Project ID: Project settings.
NEON_API_KEY=
NEON_PROJECT_ID=
COMPUTE_BUDGET_CU_HOURS=50

# ── Scripts (backtests, fits) ───────────────────────────────────────────────
# SAVE_REPORT="1"   # backtests save their report card for /models (Model Lab sets it)
# V1_LIMIT="1500"   # backtest:ufc-fights: cap on v1 rebuilds
