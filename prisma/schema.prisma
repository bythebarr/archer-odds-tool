// Prisma schema for archer-odds-tool (v1: MLB game lines only)
// See /home/codespace/.claude/plans/sequential-moseying-treehouse.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MarketType {
  h2h // moneyline
  spreads
  totals
}

enum Side {
  home
  away
  over
  under
  draw // soccer h2h's third outcome — line-shopping only, no devig/EV (see lineEconomics.ts, 2-way only)
}

enum GameStatus {
  scheduled
  live
  final
  postponed
}

enum OutcomeResult {
  hit
  miss
  push
}

/// Which ledger a play belongs to. The owner handpicks BOTH streams daily from
/// the deck; everything he doesn't pick posts to the premium slate carrying no
/// units and is never recorded, so it never touches a record.
enum PlayStream {
  /// Premium #todays-card — the handpicked plays units ride on. The headline record.
  card
  /// The single daily #free-play, tracked on its own separate record.
  free
}

enum Sport {
  mlb
  tennis
  soccer
  ufc // graded Discord plays only (fighter-math moneyline) — UFC never uses the Game table
  nfl // team sport on the shared Game table, like MLB; teams upserted by oddsApiName like soccer's
}

/// mlbTeamId is MLB-only (nullable so soccer/NFL rows can omit it); soccer and
/// NFL teams are instead upserted by oddsApiName, mirroring Player's pattern,
/// since there's no free authoritative team-id source for them the way MLB Stats
/// API provides. abbreviation/league/division are still required but hold
/// synthesized or placeholder values there (no real crest/league data source yet)
/// — see soccer/ingest.ts and nfl/ingest.ts's upsertTeam.
///
/// There is deliberately no `sport` column: oddsApiName is the natural key and
/// full team names don't collide across leagues (Arizona Cardinals vs St. Louis
/// Cardinals, New York Giants vs San Francisco Giants). Scope by joining through
/// Game.sport, which is indexed, rather than duplicating the discriminator here.
model Team {
  id           String  @id @default(cuid())
  mlbTeamId    Int?    @unique
  oddsApiName  String? @unique
  name         String
  abbreviation String
  league       String
  division     String

  homeGames      Game[]          @relation("HomeTeam")
  awayGames      Game[]          @relation("AwayTeam")
  outcomes       GameOutcome[]
  playerGameLogs PlayerGameLog[]

  @@index([mlbTeamId])
}

/// A tennis competitor. Deliberately minimal — no rankings/H2H/surface stats,
/// since no free/reliable live source exists for those yet (see tennis plan
/// doc). Upserted on the fly by the tennis odds poller the first time a
/// player's name is seen in an Odds API event; there is no separate
/// schedule-sync job populating this ahead of time the way MLB's Team is.
model Player {
  id          String   @id @default(cuid())
  name        String
  oddsApiName String?  @unique // The Odds API's exact player name string, used to upsert idempotently across polls
  createdAt   DateTime @default(now())

  homeMatches Game[]        @relation("HomePlayer")
  awayMatches Game[]        @relation("AwayPlayer")
  outcomes    GameOutcome[]
}

/// Historical tennis match archive, imported from the free public Jeff Sackmann
/// ATP/WTA CSVs (scripts/import-tennis-archive.ts). This is the training + backtest
/// base for the surface-aware Elo model — our live odds Game rows are forward-only
/// and far too shallow to build ratings from. Keyed on Sackmann's own stable player
/// ids (winnerSackId/loserSackId) so Elo never depends on name matching; names are
/// kept only to join a live Odds API competitor to their rating at pricing time.
/// Independent of Game/Player on purpose (mirrors how UFC added its own table family
/// rather than overloading Game). Costs zero Odds API credits — pure free data.
model TennisArchiveMatch {
  id     String @id @default(cuid())
  tour   String // "atp" | "wta"

  tourneyId    String
  tourneyName  String
  surface      String? // "Hard" | "Clay" | "Grass" | "Carpet" (nullable — a few rows lack it)
  tourneyLevel String? // G=Grand Slam, M=Masters, A=ATP 500/250, D=Davis Cup, etc.
  round        String? // R128..F
  /// Tournament start date (Sackmann's tourney_date, YYYYMMDD). Elo replays in
  /// (tourneyDate, matchNum) order — matches within an event are ordered by matchNum.
  tourneyDate  DateTime
  matchNum     Int
  bestOf       Int?

  winnerSackId     String
  winnerName       String
  winnerNorm       String // normalized (lowercased, accent-stripped) for live-name matching
  winnerRank       Int?
  winnerRankPoints Int?
  winnerAces       Int? // free serve stat — seeds a future ace/serve prop model
  winnerDfs        Int?

  loserSackId     String
  loserName       String
  loserNorm       String
  loserRank       Int?
  loserRankPoints Int?
  loserAces       Int?
  loserDfs        Int?

  score String?

  // Natural key for idempotent re-import (re-running the cron never dupes a match).
  @@unique([tour, tourneyId, matchNum])
  @@index([tourneyDate])
  @@index([winnerNorm])
  @@index([loserNorm])
}

/// Current surface-aware Elo rating per archived player — the precomputed snapshot
/// live pricing reads (replaying 62k archive matches on every board render would be
/// far too slow). Rebuilt in full from TennisArchiveMatch by scripts/compute-tennis-
/// ratings.ts after each import (see src/lib/tennis/ratings.ts). Keyed on Sackmann's
/// stable player id; `norm` is the normalized-name join to a live Odds API competitor.
model TennisRating {
  id       String @id @default(cuid())
  sackId   String @unique
  tour     String
  name     String
  norm     String // normalized name — the live-match join key
  overall  Float
  hard     Float?
  clay     Float?
  grass    Float?
  carpet   Float?
  nOverall Int // career matches seen — confidence gate for pricing

  updatedAt DateTime @default(now())

  @@index([norm])
}

/// One row per game (MLB, soccer) or match (tennis) — `sport` decides which
/// of the team/player FK pairs below is populated. Soccer reuses the same
/// team-pair shape as MLB (homeTeamId/awayTeamId), just via a different Team
/// upsert path (see Team's docstring). Both pairs are nullable because
/// Postgres NULL columns cost nothing and a CHECK constraint (added by hand
/// in the migration, not expressible in Prisma's schema DSL) enforces that
/// exactly one pair is set per row, matching `sport`. See the tennis plan
/// doc (sparkling-plotting-meteor.md) for why this was chosen over a fully
/// normalized split-table design: every sport-specific query/UI component is
/// already sport-specific, so there's no shared join path a split would protect.
model Game {
  id                String     @id @default(cuid())
  sport             Sport      @default(mlb)
  mlbGameId         Int?       @unique
  oddsApiEventId    String?    @unique
  season            Int
  scheduledStartUtc DateTime
  status            GameStatus @default(scheduled)
  /// Tennis only — court surface ("Hard"|"Clay"|"Grass"|"Carpet"), derived from
  /// the polled tournament sport_key at ingest (see tennis/surface.ts). Feeds the
  /// surface-aware Elo model's live pricing; null when unknown (model falls back to
  /// overall Elo). Not populated for team sports.
  surface           String?

  homeTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homePlayerId String?
  homePlayer   Player? @relation("HomePlayer", fields: [homePlayerId], references: [id])
  awayPlayerId String?
  awayPlayer   Player? @relation("AwayPlayer", fields: [awayPlayerId], references: [id])

  homeScore Int?
  awayScore Int?

  // Nullable: MLB usually doesn't confirm starters until 1-5 days out, so
  // these are legitimately empty for most of the forward-looking sync window.
  homeProbablePitcherId String?
  homeProbablePitcher   Pitcher? @relation("HomeProbablePitcher", fields: [homeProbablePitcherId], references: [id])
  awayProbablePitcherId String?
  awayProbablePitcher   Pitcher? @relation("AwayProbablePitcher", fields: [awayProbablePitcherId], references: [id])

  oddsSnapshots          OddsSnapshot[]
  currentLines           CurrentOddsLine[]
  closingLines           GameClosingLine[]
  outcomes               GameOutcome[]
  playerGameLogs         PlayerGameLog[]
  playerPropSnapshots    PlayerPropSnapshot[]
  currentPlayerPropLines CurrentPlayerPropLine[]
  lineupSlots            LineupSlot[]

  @@index([scheduledStartUtc])
  @@index([status])
  @@index([sport])
}

/**
 * A confirmed starting-lineup spot for one game — the posted batting order,
 * ingested from the MLB Stats API boxscore's `battingOrder` once the lineup
 * drops (a few hours pre-game). Lets the props board show actual starters
 * instead of "recently active" players. Fully replaced per game on each sync
 * (scratches happen), so it always reflects the latest posted card.
 */
model LineupSlot {
  id           String @id @default(cuid())
  gameId       String
  game         Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId       String
  mlbPersonId  Int
  /** 1-9, the batting-order position. */
  battingOrder Int

  @@unique([gameId, mlbPersonId])
  @@index([gameId])
  @@index([teamId])
}

model Pitcher {
  id          String @id @default(cuid())
  mlbPersonId Int    @unique
  fullName    String

  seasonStats       PitcherSeasonStats[]
  homeProbableGames Game[]               @relation("HomeProbablePitcher")
  awayProbableGames Game[]               @relation("AwayProbablePitcher")
}

/// Upsert-latest season pitching line (wins/losses/ERA), refreshed on every
/// pitcher sync — informational context, not something graded/tracked over
/// time like odds, so no snapshot history is kept.
model PitcherSeasonStats {
  id             String   @id @default(cuid())
  pitcherId      String
  pitcher        Pitcher  @relation(fields: [pitcherId], references: [id])
  season         Int
  wins           Int
  losses         Int
  era            Float? // null on parse failure (e.g. 0-IP rookie call-ups return a non-numeric ERA string)
  inningsPitched Float?
  gamesStarted   Int
  updatedAt      DateTime @updatedAt

  @@unique([pitcherId, season])
}

enum Handedness {
  L
  R
  S // switch-hitter — batSide only, pitchHand is never S
}

enum StatCategory {
  hits
  totalBases
  homeRuns
  rbi
  runs
  battingStrikeouts
  pitcherStrikeouts
  earnedRuns
  hitsAllowed
  walksAllowed
  outsRecorded
}

/// A general MLB player identity (batter or pitcher, by mlbPersonId),
/// deliberately separate from Pitcher above rather than unifying them — the
/// same non-unification call as tennis's Player vs Team (see Team's
/// docstring): Pitcher already has a narrow, working purpose (the Archer
/// matchup model's probable-starter ERA), and retrofitting it into a general
/// player identity risks that existing feature for no real gain. A real
/// two-way player (e.g. a pitcher who also bats) will have rows in both
/// tables under the same mlbPersonId — that's fine, they're independent.
model MlbPlayer {
  id          String      @id @default(cuid())
  mlbPersonId Int         @unique
  fullName    String
  batSide     Handedness?
  pitchHand   Handedness?

  gameLogs            PlayerGameLog[]         @relation("PlayerLogs")
  opposingStarterLogs PlayerGameLog[]         @relation("OpposingStarterLogs")
  propSnapshots       PlayerPropSnapshot[]
  currentPropLines    CurrentPlayerPropLine[]

  @@index([mlbPersonId])
}

/// One row per player per game — the hit-rate engine's only source of truth.
/// Wide (nullable batting/pitching column groups on the same row) rather
/// than an EAV table: matches how MLB Stats API's boxscore naturally
/// delivers one stat line per player per game, and keeps windowed hit-rate
/// queries (last N rows for a player, ordered by gameDate) a simple indexed
/// scan instead of a pivot. A two-way player has both groups populated on
/// the same row. Backfilled once from full-season boxscore history (free,
/// MLB Stats API — see scripts/backfill-player-game-logs.ts), then kept
/// current by a daily cron, independent of any odds polling.
model PlayerGameLog {
  id       String   @id @default(cuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id])
  // Denormalized off Game.scheduledStartUtc so windowed queries (last N for
  // a player) don't need to join Game just to order/filter by date.
  gameDate DateTime

  mlbPlayerId String
  mlbPlayer   MlbPlayer @relation("PlayerLogs", fields: [mlbPlayerId], references: [id])
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  isHome      Boolean

  // The opposing team's starter that game — the reference point for the
  // "vs LHP/RHP" split. Hand is denormalized (copied from MlbPlayer.pitchHand
  // at ingest time) so the split filter never needs a join.
  opposingStarterId   String?
  opposingStarter     MlbPlayer?  @relation("OpposingStarterLogs", fields: [opposingStarterId], references: [id])
  opposingStarterHand Handedness?

  // Batting line — null for a game where this player didn't bat.
  atBats            Int?
  plateAppearances  Int?
  hits              Int?
  totalBases        Int?
  homeRuns          Int?
  rbi               Int?
  runs              Int?
  baseOnBalls       Int?
  strikeoutsBatting Int?
  stolenBases       Int?

  // Pitching line — null for a game where this player didn't pitch.
  isStarter          Boolean?
  outsRecorded       Int?
  strikeoutsPitching Int?
  earnedRuns         Int?
  hitsAllowed        Int?
  walksAllowed       Int?

  @@unique([mlbPlayerId, gameId])
  @@index([mlbPlayerId, gameDate])
  @@index([mlbPlayerId, opposingStarterHand, gameDate])
}

model Sportsbook {
  key         String  @id // e.g. "draftkings" — matches The Odds API's bookmaker key
  displayName String
  region      String // allowlist filter: only US-legal books belong here
  logoUrl     String?
  active      Boolean @default(true)

  oddsSnapshots          OddsSnapshot[]
  currentLines           CurrentOddsLine[]
  playerPropSnapshots    PlayerPropSnapshot[]
  currentPlayerPropLines CurrentPlayerPropLine[]
  ufcBoutOdds            UfcBoutOdds[]
}

/// Append-only fact table: every polled price, forever. Source of truth for
/// history, backtesting, and closing-line capture. Never updated, only inserted.
model OddsSnapshot {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  bookKey       String
  book          Sportsbook @relation(fields: [bookKey], references: [key])
  marketType    MarketType
  side          Side
  point         Float? // spread/total number; genuinely null for h2h (no sentinel needed — append-only, no unique constraint)
  priceAmerican Int
  isAlternate   Boolean    @default(false) // true if sourced from alternate_spreads/alternate_totals rather than the main market

  polledAt         DateTime @default(now())
  sourceLastUpdate DateTime // the book's own last-update time, from the Odds API payload

  @@index([gameId, marketType, bookKey, polledAt])
}

/// Upsert-latest convenience table, written in the same transaction as each
/// OddsSnapshot insert, so the slider UI does an O(1) indexed lookup instead
/// of a window-function query over OddsSnapshot on the hot path.
model CurrentOddsLine {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  bookKey       String
  book          Sportsbook @relation(fields: [bookKey], references: [key])
  marketType    MarketType
  side          Side
  point         Float? // NOTE: stored as 0 (sentinel), never null, for h2h rows — Postgres NULL<>NULL would break
  // upsert idempotency for the unique constraint below otherwise. Always null in every
  // other table (OddsSnapshot, GameClosingLine); normalize back to null at the query layer.
  priceAmerican Int
  isAlternate   Boolean    @default(false) // true if sourced from alternate_spreads/alternate_totals rather than the main market
  polledAt      DateTime

  @@unique([gameId, bookKey, marketType, side, point])
}

/// Append-only fact table for player-prop prices, mirroring OddsSnapshot's
/// shape/purpose but keyed by (gameId, mlbPlayerId, statCategory) instead of
/// team side — props are always Over/Under against a single player, never a
/// two-competitor market. Fetched via the per-event endpoint (see
/// oddsApiClient.fetchEventPlayerProps), never the bulk endpoint — see
/// odds_api_credit_budget notes on why props cost scales per-game.
model PlayerPropSnapshot {
  id            String       @id @default(cuid())
  gameId        String
  game          Game         @relation(fields: [gameId], references: [id])
  mlbPlayerId   String
  mlbPlayer     MlbPlayer    @relation(fields: [mlbPlayerId], references: [id])
  bookKey       String
  book          Sportsbook   @relation(fields: [bookKey], references: [key])
  statCategory  StatCategory
  side          Side // over | under only — never home/away/draw
  point         Float // the prop line, e.g. 1.5 hits — never null, unlike CurrentOddsLine's spread/totals point
  priceAmerican Int

  polledAt         DateTime @default(now())
  sourceLastUpdate DateTime

  @@index([gameId, mlbPlayerId, statCategory, bookKey, polledAt])
}

/// Upsert-latest convenience table for player props, same purpose as
/// CurrentOddsLine. point is part of the unique key (not a NULL/sentinel
/// concern here — props always carry a real point), so a book moving a
/// player's line creates a new current-line row rather than overwriting the
/// old point in place, matching CurrentOddsLine's behavior for spreads/totals.
model CurrentPlayerPropLine {
  id            String       @id @default(cuid())
  gameId        String
  game          Game         @relation(fields: [gameId], references: [id])
  mlbPlayerId   String
  mlbPlayer     MlbPlayer    @relation(fields: [mlbPlayerId], references: [id])
  bookKey       String
  book          Sportsbook   @relation(fields: [bookKey], references: [key])
  statCategory  StatCategory
  side          Side
  point         Float
  priceAmerican Int
  polledAt      DateTime

  @@unique([gameId, mlbPlayerId, bookKey, statCategory, side, point])
}

/// Consensus point/price captured at the last snapshot before first pitch —
/// the number hit-rate grading is measured against for spread/totals.
model GameClosingLine {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  marketType    MarketType
  side          Side
  point         Float?
  priceAmerican Int
  capturedAt    DateTime

  @@unique([gameId, marketType, side])
}

/// Graded outcome per competitor/market, computed once a game is final.
/// Exactly one of teamId/playerId is set per row (CHECK constraint added by
/// hand in the migration — see Game's docstring for why). Two separate
/// unique constraints rather than one: Postgres treats NULL <> NULL, so a
/// single `@@unique([gameId, teamId, playerId, marketType])` would never
/// fire for tennis rows (teamId always null there) and every regrade would
/// insert a duplicate instead of updating — the same bug class
/// CurrentOddsLine's h2h "0 sentinel" comment documents elsewhere.
model GameOutcome {
  id         String        @id @default(cuid())
  gameId     String
  game       Game          @relation(fields: [gameId], references: [id])
  teamId     String?
  team       Team?         @relation(fields: [teamId], references: [id])
  playerId   String?
  player     Player?       @relation(fields: [playerId], references: [id])
  marketType MarketType
  result     OutcomeResult
  gradedAt   DateTime      @default(now())

  @@unique([gameId, teamId, marketType])
  @@unique([gameId, playerId, marketType])
  @@index([teamId, marketType])
  @@index([playerId, marketType])
}

/// A specific play the Discord auto-poster put on the daily card — the record
/// of what was *actually posted*, so #results can grade it the next day and
/// keep a running unit ledger. Stateless posting can't do this; this table is
/// the memory. Deliberately no Game relation (kept as a plain matchId) to keep
/// the migration a single additive table with no alter to Game.
///
/// Grading states: gradedAt null = pending; gradedAt set + voided = no result
/// possible (soccer/tennis game lines, or a prop with a missing stat line — a
/// DNP is never a loss); gradedAt set + result = settled (hit/miss/push).
model PostedPlay {
  id             String        @id @default(cuid())
  /// ET card date (YYYY-MM-DD) this play was posted for.
  postedForDate  String
  /// OddsPlay.key — dedupes a play within a date across re-posts.
  playKey        String
  /// Registry key of the producing adapter ("mlb", "ufc", ...) — a plain string,
  /// NOT the `Sport` enum, so a new sport flows through the ledger/grader without
  /// a DB enum migration (sport-engine Phase 3). Grading dispatches on this via
  /// getAdapter(sport). The enum survives only on `Game.sport`, a typed relation.
  sport          String
  matchId        String
  market         MarketType?   // null for props
  kind           String        // ml | spread | total | prop
  side           String        // home | away | over | under | draw
  point          Float?
  selectionLabel String
  bestPrice      Int
  bestBookName   String
  ev             Float?
  units          Float
  /// Which ledger this row counts toward — #results reports card and free
  /// SEPARATELY (owner's call: the free play must not flatter or drag the
  /// premium record). Defaults to `card` so pre-split paper-log rows, which were
  /// all premium-card posts, keep counting where they always did.
  stream         PlayStream    @default(card)
  // Prop grading inputs (null for game lines).
  mlbPlayerId    String?
  statCategory   StatCategory?
  // Grading output.
  result         OutcomeResult? // hit | miss | push; null while pending or when voided
  voided         Boolean        @default(false)
  gradedAt       DateTime?
  createdAt      DateTime       @default(now())

  @@unique([postedForDate, playKey])
  @@index([postedForDate])
  @@index([gradedAt])
  @@index([stream])
}

/// The owner's handpicks for a day, chosen in the deck (/deck) BEFORE the card
/// posts. Kept separate from PostedPlay because a selection is an intent, not a
/// result: he can tick and un-tick all morning, and prices keep moving until the
/// poster fires. At post time the poster re-reads live plays, matches them by
/// playKey, and only then writes PostedPlay rows at the price that actually
/// posted. A playKey with no matching live play (line pulled, event scratched)
/// is dropped with a warning rather than posted at a stale number.
model CardSelection {
  id        String     @id @default(cuid())
  /// ET card date (YYYY-MM-DD) this selection is for.
  dateEt    String
  /// Play.playKey — matches the live play at post time.
  playKey   String
  stream    PlayStream
  /// Owner's stake for this play. NULL means "use the model's suggestion" — the
  /// distinction matters: an explicit 1u and an unset 1u look identical in the
  /// posted card but mean different things if the Kelly sizing later changes.
  units     Float?
  createdAt DateTime   @default(now())

  @@unique([dateEt, playKey])
  @@index([dateEt])
}

/// Drives the tiered polling throttle — last successful poll timestamp per job.
model PollLog {
  jobName          String   @id
  lastPolledAt     DateTime
  lastStatus       String
  creditsUsed      Int?
  creditsRemaining Int?
}

/// Append-only history of credit snapshots, one row per poll — PollLog
/// itself upserts a single row per job (all it needs for "is this job due
/// yet" cadence checks), so it can't answer "how has credit usage trended
/// over time." This table exists purely for that; written alongside PollLog
/// on every recordPollLog call that carries a non-null credits value.
model PollCreditLog {
  id               String   @id @default(cuid())
  jobName          String
  polledAt         DateTime @default(now())
  creditsUsed      Int?
  creditsRemaining Int?

  @@index([jobName, polledAt])
}

// ---------------------------------------------------------------------------
// UFC (Phase 1: fight-history foundation, sourced from Cito API — a
// completely separate provider/budget from The Odds API above, no sportsbook
// odds involved at all yet). Fight-graph-shaped by design — UfcBout is an
// edge between two UfcFighters (red/blue corner, mirroring Cito's own
// terminology rather than inventing home/away for a sport with no home
// venue concept) — so Phase 2's common-opponent/style-matchup analysis can
// traverse this data without a schema rework. See the "fighter math"
// conversation this was scoped in for why Phase 2 isn't built yet.
//
// Known Cito data-quality caveat, confirmed live: some events' eventDate is
// off by exactly one year (UFC 318, the real Poirier-Holloway card from
// July 2025, is dated 2026-07-19 in their system) — every such case
// observed so far also has hasStats=false. hasStats (denormalized from
// Cito's own event-level flag) is the practical trust signal: bout results
// are stored regardless, but detailed stats are only ever fetched for
// hasStats=true bouts, and eventDate on hasStats=false events shouldn't be
// trusted for anything date-sensitive.
// ---------------------------------------------------------------------------

/// A UFC fighter, upserted incrementally from whichever Cito response first
/// mentions them (event/bout listings embed a fighter profile inline — no
/// separate full-roster backfill needed, mirroring how tennis's Player is
/// upserted on the fly rather than pre-synced).
model UfcFighter {
  id       String  @id @default(cuid())
  citoSlug String  @unique
  fullName String
  nickname String?
  division String? // current weight class, not bout-specific (a fighter's UfcBout.weightClass can differ, e.g. a catchweight bout)
  stance   String?
  imageUrl String? // headshot from Cito's UFC.com CDN (profile.headshotUrl, falling back to the bout's standing-body image); nullable — not every fighter row has one, and the UI falls back to an initials badge

  heightInches Float?
  reachInches  Float?

  recordWins      Int?
  recordLosses    Int?
  recordDraws     Int?
  recordNoContest Int?

  redCornerBouts  UfcBout[]             @relation("RedCorner")
  blueCornerBouts UfcBout[]             @relation("BlueCorner")
  wonBouts        UfcBout[]             @relation("Winner")
  boutStats       UfcBoutFighterStats[]
  roundStats      UfcBoutRoundStats[]

  @@index([citoSlug])
}

model UfcEvent {
  id          String   @id @default(cuid())
  citoEventId String   @unique
  citoSlug    String   @unique
  title       String
  eventDate   DateTime // see the caveat above — not trustworthy on hasStats=false events
  venue       String?
  city        String?
  country     String?
  hasStats    Boolean  @default(false) // Cito's own event-level flag, refreshed on every backfill pass

  bouts UfcBout[]

  @@index([eventDate])
}

model UfcBout {
  id         String   @id @default(cuid())
  citoBoutId String   @unique
  eventId    String
  event      UfcEvent @relation(fields: [eventId], references: [id])

  // The Odds API event id this bout was matched to, cached on the first
  // successful odds match so later polls skip the fuzzy name-pair lookup
  // (mirrors Game.oddsApiEventId).
  oddsApiEventId String? @unique

  weightClass String
  titleBout   Boolean @default(false)
  cardSection String?
  boutOrder   Int?

  redCornerFighterId  String
  redCornerFighter    UfcFighter @relation("RedCorner", fields: [redCornerFighterId], references: [id])
  blueCornerFighterId String
  blueCornerFighter   UfcFighter @relation("BlueCorner", fields: [blueCornerFighterId], references: [id])

  status          String // raw Cito status string ("scheduled" | "completed" | "cancelled" | ...) — not normalized into an enum since the full vocabulary isn't characterized yet
  winnerFighterId String?
  winnerFighter   UfcFighter? @relation("Winner", fields: [winnerFighterId], references: [id])
  method          String? // raw Cito string (formatting varies by endpoint, e.g. "KO/TKO" vs "Decision - Unanimous") — stored as-is, normalized at the query layer once the real vocabulary is known
  methodDetails   String?
  resultRound     Int?
  resultTime      String?

  // Our own fetch-state marker, separate from UfcEvent.hasStats (Cito's
  // event-level hint) — this is the actual dedup/pacing signal for the
  // batched bout-stats backfill cron, set only once we've successfully
  // stored this bout's own stats.
  statsFetchedAt DateTime?

  fighterStats UfcBoutFighterStats[]
  roundStats   UfcBoutRoundStats[]
  boutOdds     UfcBoutOdds[]

  @@index([eventId])
  @@index([redCornerFighterId])
  @@index([blueCornerFighterId])
  @@index([statsFetchedAt])
}

/// UFC moneyline (h2h) odds — one upsert-latest row per bout × book × corner.
/// Mirrors CurrentOddsLine, but moneyline-only, so there's no market/point
/// column: UFC h2h is always a 2-way red-vs-blue market, and The Odds API
/// exposes no method/round/distance props for MMA (confirmed live via
/// INVALID_MARKET). Feeds best-line shopping and the fighter-math EV card.
/// Line-movement history (an append-only OddsSnapshot analog) is deferred to
/// phase 2 — this table alone answers "what's the price right now".
model UfcBoutOdds {
  id            String     @id @default(cuid())
  boutId        String
  bout          UfcBout    @relation(fields: [boutId], references: [id])
  bookKey       String
  book          Sportsbook @relation(fields: [bookKey], references: [key])
  corner        String // "red" | "blue" — which corner this price is for
  priceAmerican Int

  polledAt         DateTime
  sourceLastUpdate DateTime // the book's own last-update time from the Odds API payload

  @@unique([boutId, bookKey, corner])
  @@index([boutId])
}

/// Bout-level aggregate stats, one row per fighter per bout — mirrors
/// PlayerGameLog's one-row-per-player-per-game shape. Landed/attempted
/// pairs throughout (Cito returns "X of Y" strings; parsed into two ints on
/// ingest — see citoStats.ts).
model UfcBoutFighterStats {
  id        String     @id @default(cuid())
  boutId    String
  bout      UfcBout    @relation(fields: [boutId], references: [id])
  fighterId String
  fighter   UfcFighter @relation(fields: [fighterId], references: [id])

  knockdowns         Int
  submissionAttempts Int
  reversals          Int
  controlTimeSeconds Int

  significantStrikesLanded    Int
  significantStrikesAttempted Int
  totalStrikesLanded          Int
  totalStrikesAttempted       Int
  takedownsLanded             Int
  takedownsAttempted          Int

  headStrikesLanded    Int
  headStrikesAttempted Int
  bodyStrikesLanded    Int
  bodyStrikesAttempted Int
  legStrikesLanded     Int
  legStrikesAttempted  Int

  distanceStrikesLanded    Int
  distanceStrikesAttempted Int
  clinchStrikesLanded      Int
  clinchStrikesAttempted   Int
  groundStrikesLanded      Int
  groundStrikesAttempted   Int

  @@unique([boutId, fighterId])
}

/// Same field shape as UfcBoutFighterStats, scoped to a single round —
/// separate table rather than a roundNumber-nullable column on the same
/// model, since "bout aggregate" and "one round" are genuinely different
/// grains (a 3-round decision has 1 aggregate row + 3 round rows per
/// fighter, and aggregate isn't just a sum of rounds we happen to have —
/// Cito provides both independently).
model UfcBoutRoundStats {
  id        String     @id @default(cuid())
  boutId    String
  bout      UfcBout    @relation(fields: [boutId], references: [id])
  fighterId String
  fighter   UfcFighter @relation(fields: [fighterId], references: [id])
  round     Int

  knockdowns         Int
  submissionAttempts Int
  reversals          Int
  controlTimeSeconds Int

  significantStrikesLanded    Int
  significantStrikesAttempted Int
  totalStrikesLanded          Int
  totalStrikesAttempted       Int
  takedownsLanded             Int
  takedownsAttempted          Int

  headStrikesLanded    Int
  headStrikesAttempted Int
  bodyStrikesLanded    Int
  bodyStrikesAttempted Int
  legStrikesLanded     Int
  legStrikesAttempted  Int

  distanceStrikesLanded    Int
  distanceStrikesAttempted Int
  clinchStrikesLanded      Int
  clinchStrikesAttempted   Int
  groundStrikesLanded      Int
  groundStrikesAttempted   Int

  @@unique([boutId, fighterId, round])
}

// ---------------------------------------------------------------------------
// Formula 1 — free historical results foundation via the Jolpica API (the
// no-auth Ergast successor, api.jolpi.ca). Mirrors the UFC Phase-1 approach:
// data-only, ingested by a dormant cron, no odds and no UI yet. External
// `ergast*Id` fields are Jolpica's own stable slugs (e.g. "max_verstappen",
// "red_bull", "bahrain") and are what ingest upserts on.
// ---------------------------------------------------------------------------

model F1Driver {
  id              String    @id @default(cuid())
  ergastDriverId  String    @unique // Jolpica driverId slug, e.g. "max_verstappen"
  code            String? // 3-letter TV code, e.g. "VER" (missing for some historical drivers)
  permanentNumber Int?
  givenName       String
  familyName      String
  nationality     String?
  dateOfBirth     DateTime?

  results F1RaceResult[]

  @@index([ergastDriverId])
}

model F1Constructor {
  id                  String @id @default(cuid())
  ergastConstructorId String @unique // Jolpica constructorId slug, e.g. "red_bull"
  name                String
  nationality         String?

  results F1RaceResult[]

  @@index([ergastConstructorId])
}

model F1Circuit {
  id             String  @id @default(cuid())
  ergastCircuitId String @unique // Jolpica circuitId slug, e.g. "bahrain"
  name           String
  locality       String?
  country        String?
  lat            Float?
  long           Float?

  races F1Race[]
}

model F1Race {
  id       String    @id @default(cuid())
  season   Int
  round    Int
  raceName String
  raceDate DateTime // combined date+time when Jolpica provides a time, else midnight UTC of the date
  wikiUrl  String?

  circuitId String
  circuit   F1Circuit @relation(fields: [circuitId], references: [id])

  results F1RaceResult[]

  @@unique([season, round])
  @@index([raceDate])
  @@index([circuitId])
}

/// One row per driver per race — mirrors PlayerGameLog's one-row-per-entity-
/// per-event grain. `positionText` keeps the raw Ergast value ("1", "R" for
/// retired, "D" disqualified, etc.); `position` is the numeric finishing
/// place, null when the car didn't classify.
model F1RaceResult {
  id     String @id @default(cuid())
  raceId String
  race   F1Race @relation(fields: [raceId], references: [id])

  driverId String
  driver   F1Driver @relation(fields: [driverId], references: [id])

  constructorId String
  constructor   F1Constructor @relation(fields: [constructorId], references: [id])

  position     Int?
  positionText String
  points       Float
  grid         Int?
  laps         Int?
  status       String // raw Ergast status, e.g. "Finished", "+1 Lap", "Engine", "Collision"

  timeMillis     Int? // total race time in ms (winner only has an absolute time; others are gaps)
  fastestLapRank Int?
  fastestLapTime String?

  @@unique([raceId, driverId])
  @@index([driverId])
  @@index([constructorId])
}

/// User-submitted support/feedback, written by the /support form via
/// /api/feedback. Self-contained (no email/Discord dependency): submissions
/// land here and are read from the token-gated inbox at /support/inbox. A
/// future notification hook (email, Discord webhook) can layer on top without
/// schema changes. `context` records where the report came from (e.g. an empty
/// board's supportContext) so a "dashboard's blank" report is actionable.
model Feedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  category  String // "bug" | "data" | "billing" | "feature" | "account" | "other"
  message   String
  email     String? // optional reply-to the user provides
  context   String? // originating surface, e.g. "props-empty", "mlb-empty"
  userAgent String?
  resolved  Boolean  @default(false)

  @@index([createdAt])
  @@index([resolved])
}
