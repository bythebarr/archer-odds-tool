// Prisma schema for archer-odds-tool (v1: MLB game lines only)
// See /home/codespace/.claude/plans/sequential-moseying-treehouse.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MarketType {
  h2h // moneyline
  spreads
  totals
}

enum Side {
  home
  away
  over
  under
  draw // soccer h2h's third outcome — line-shopping only, no devig/EV (see lineEconomics.ts, 2-way only)
}

enum GameStatus {
  scheduled
  live
  final
  postponed
}

enum OutcomeResult {
  hit
  miss
  push
}

enum Sport {
  mlb
  tennis
  soccer
}

/// mlbTeamId is MLB-only (nullable so soccer rows can omit it); soccer teams
/// are instead upserted by oddsApiName, mirroring Player's pattern, since
/// there's no free authoritative team-id source for international soccer the
/// way MLB Stats API provides. abbreviation/league/division are still
/// required but hold synthesized placeholder values for soccer (no real
/// crest/league data source yet) — see soccer/ingest.ts's upsertTeam.
model Team {
  id           String   @id @default(cuid())
  mlbTeamId    Int?     @unique
  oddsApiName  String?  @unique
  name         String
  abbreviation String
  league       String
  division     String

  homeGames Game[]        @relation("HomeTeam")
  awayGames Game[]        @relation("AwayTeam")
  outcomes  GameOutcome[]

  @@index([mlbTeamId])
}

/// A tennis competitor. Deliberately minimal — no rankings/H2H/surface stats,
/// since no free/reliable live source exists for those yet (see tennis plan
/// doc). Upserted on the fly by the tennis odds poller the first time a
/// player's name is seen in an Odds API event; there is no separate
/// schedule-sync job populating this ahead of time the way MLB's Team is.
model Player {
  id          String   @id @default(cuid())
  name        String
  oddsApiName String?  @unique // The Odds API's exact player name string, used to upsert idempotently across polls
  createdAt   DateTime @default(now())

  homeMatches Game[]        @relation("HomePlayer")
  awayMatches Game[]        @relation("AwayPlayer")
  outcomes    GameOutcome[]
}

/// One row per game (MLB, soccer) or match (tennis) — `sport` decides which
/// of the team/player FK pairs below is populated. Soccer reuses the same
/// team-pair shape as MLB (homeTeamId/awayTeamId), just via a different Team
/// upsert path (see Team's docstring). Both pairs are nullable because
/// Postgres NULL columns cost nothing and a CHECK constraint (added by hand
/// in the migration, not expressible in Prisma's schema DSL) enforces that
/// exactly one pair is set per row, matching `sport`. See the tennis plan
/// doc (sparkling-plotting-meteor.md) for why this was chosen over a fully
/// normalized split-table design: every sport-specific query/UI component is
/// already sport-specific, so there's no shared join path a split would protect.
model Game {
  id                String     @id @default(cuid())
  sport             Sport      @default(mlb)
  mlbGameId         Int?       @unique
  oddsApiEventId    String?    @unique
  season            Int
  scheduledStartUtc DateTime
  status            GameStatus @default(scheduled)

  homeTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homePlayerId String?
  homePlayer   Player? @relation("HomePlayer", fields: [homePlayerId], references: [id])
  awayPlayerId String?
  awayPlayer   Player? @relation("AwayPlayer", fields: [awayPlayerId], references: [id])

  homeScore Int?
  awayScore Int?

  // Nullable: MLB usually doesn't confirm starters until 1-5 days out, so
  // these are legitimately empty for most of the forward-looking sync window.
  homeProbablePitcherId String?
  homeProbablePitcher   Pitcher? @relation("HomeProbablePitcher", fields: [homeProbablePitcherId], references: [id])
  awayProbablePitcherId String?
  awayProbablePitcher   Pitcher? @relation("AwayProbablePitcher", fields: [awayProbablePitcherId], references: [id])

  oddsSnapshots  OddsSnapshot[]
  currentLines   CurrentOddsLine[]
  closingLines   GameClosingLine[]
  outcomes       GameOutcome[]

  @@index([scheduledStartUtc])
  @@index([status])
  @@index([sport])
}

model Pitcher {
  id          String @id @default(cuid())
  mlbPersonId Int    @unique
  fullName    String

  seasonStats       PitcherSeasonStats[]
  homeProbableGames Game[]               @relation("HomeProbablePitcher")
  awayProbableGames Game[]               @relation("AwayProbablePitcher")
}

/// Upsert-latest season pitching line (wins/losses/ERA), refreshed on every
/// pitcher sync — informational context, not something graded/tracked over
/// time like odds, so no snapshot history is kept.
model PitcherSeasonStats {
  id             String   @id @default(cuid())
  pitcherId      String
  pitcher        Pitcher  @relation(fields: [pitcherId], references: [id])
  season         Int
  wins           Int
  losses         Int
  era            Float? // null on parse failure (e.g. 0-IP rookie call-ups return a non-numeric ERA string)
  inningsPitched Float?
  gamesStarted   Int
  updatedAt      DateTime @updatedAt

  @@unique([pitcherId, season])
}

model Sportsbook {
  key         String  @id // e.g. "draftkings" — matches The Odds API's bookmaker key
  displayName String
  region      String // allowlist filter: only US-legal books belong here
  logoUrl     String?
  active      Boolean @default(true)

  oddsSnapshots OddsSnapshot[]
  currentLines  CurrentOddsLine[]
}

/// Append-only fact table: every polled price, forever. Source of truth for
/// history, backtesting, and closing-line capture. Never updated, only inserted.
model OddsSnapshot {
  id          String     @id @default(cuid())
  gameId      String
  game        Game       @relation(fields: [gameId], references: [id])
  bookKey     String
  book        Sportsbook @relation(fields: [bookKey], references: [key])
  marketType  MarketType
  side        Side
  point       Float? // spread/total number; genuinely null for h2h (no sentinel needed — append-only, no unique constraint)
  priceAmerican Int
  isAlternate Boolean @default(false) // true if sourced from alternate_spreads/alternate_totals rather than the main market

  polledAt         DateTime @default(now())
  sourceLastUpdate DateTime // the book's own last-update time, from the Odds API payload

  @@index([gameId, marketType, bookKey, polledAt])
}

/// Upsert-latest convenience table, written in the same transaction as each
/// OddsSnapshot insert, so the slider UI does an O(1) indexed lookup instead
/// of a window-function query over OddsSnapshot on the hot path.
model CurrentOddsLine {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  bookKey       String
  book          Sportsbook @relation(fields: [bookKey], references: [key])
  marketType    MarketType
  side          Side
  point         Float? // NOTE: stored as 0 (sentinel), never null, for h2h rows — Postgres NULL<>NULL would break
                        // upsert idempotency for the unique constraint below otherwise. Always null in every
                        // other table (OddsSnapshot, GameClosingLine); normalize back to null at the query layer.
  priceAmerican Int
  isAlternate   Boolean  @default(false) // true if sourced from alternate_spreads/alternate_totals rather than the main market
  polledAt      DateTime

  @@unique([gameId, bookKey, marketType, side, point])
}

/// Consensus point/price captured at the last snapshot before first pitch —
/// the number hit-rate grading is measured against for spread/totals.
model GameClosingLine {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id])
  marketType    MarketType
  side          Side
  point         Float?
  priceAmerican Int
  capturedAt    DateTime

  @@unique([gameId, marketType, side])
}

/// Graded outcome per competitor/market, computed once a game is final.
/// Exactly one of teamId/playerId is set per row (CHECK constraint added by
/// hand in the migration — see Game's docstring for why). Two separate
/// unique constraints rather than one: Postgres treats NULL <> NULL, so a
/// single `@@unique([gameId, teamId, playerId, marketType])` would never
/// fire for tennis rows (teamId always null there) and every regrade would
/// insert a duplicate instead of updating — the same bug class
/// CurrentOddsLine's h2h "0 sentinel" comment documents elsewhere.
model GameOutcome {
  id         String        @id @default(cuid())
  gameId     String
  game       Game          @relation(fields: [gameId], references: [id])
  teamId     String?
  team       Team?         @relation(fields: [teamId], references: [id])
  playerId   String?
  player     Player?       @relation(fields: [playerId], references: [id])
  marketType MarketType
  result     OutcomeResult
  gradedAt   DateTime      @default(now())

  @@unique([gameId, teamId, marketType])
  @@unique([gameId, playerId, marketType])
  @@index([teamId, marketType])
  @@index([playerId, marketType])
}

/// Drives the tiered polling throttle — last successful poll timestamp per job.
model PollLog {
  jobName          String   @id
  lastPolledAt     DateTime
  lastStatus       String
  creditsUsed      Int?
  creditsRemaining Int?
}

/// Append-only history of credit snapshots, one row per poll — PollLog
/// itself upserts a single row per job (all it needs for "is this job due
/// yet" cadence checks), so it can't answer "how has credit usage trended
/// over time." This table exists purely for that; written alongside PollLog
/// on every recordPollLog call that carries a non-null credits value.
model PollCreditLog {
  id               String   @id @default(cuid())
  jobName          String
  polledAt         DateTime @default(now())
  creditsUsed      Int?
  creditsRemaining Int?

  @@index([jobName, polledAt])
}
